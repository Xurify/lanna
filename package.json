{
	"name": "lanna",
	"version": "0.1.0",
	"private": true,
	"description": "An agent harness for learning languages: adaptive teaching, drills, reading, and speaking.",
	"homepage": "https://github.com/Xurify/lanna",
	"license": "AGPL-3.0-only",
	"author": {
		"name": "Xurify"
	},
	"type": "module",
	"sideEffects": [
		"*.css",
		"./src/server/**",
		"./src/agent/**",
		"./instrumentation.ts",
		"./proxy.ts",
		"./electron/**",
		"./scripts/**"
	],
	"main": "electron/main.cjs",
	"scripts": {
		"dev": "next dev -H 127.0.0.1 -p 3010",
		"build": "next build",
		"start": "next start -H 127.0.0.1 -p 3010",
		"test": "bun scripts/test.ts",
		"lint": "oxlint . && eslint .",
		"fmt": "oxfmt .",
		"fmt:check": "oxfmt --check .",
		"typecheck": "tsc --noEmit",
		"lexicon:export": "node scripts/export-slovakwiki-lexicon.mjs ../slovak.wiki",
		"sources:check": "bun scripts/check-sources.ts",
		"miss:coverage": "bun scripts/miss-contrast-coverage.ts",
		"corpus:export": "bun scripts/corpus-export.ts",
		"audio:regen": "bun scripts/regen-audio.ts",
		"desktop:dev": "node scripts/desktop-dev.mjs",
		"desktop:prod": "node scripts/desktop-dev.mjs --prod",
		"dev:fresh": "bash scripts/dev-fresh.sh",
		"dev:sandbox": "bun scripts/dev-sandbox.ts",
		"skill:sync": "bun scripts/sync-slovak-skill.ts",
		"remote:off": "bun scripts/remote-access-off.ts",
		"remote:code": "bun scripts/remote-code.ts",
		"web:password": "bun scripts/web-password.ts",
		"desktop:dist": "rm -rf dist .next/standalone && next build && node scripts/smoke-provider-runtime.mjs && node scripts/build-server.mjs && node scripts/smoke-server.mjs && DEVELOPER_DIR=${DEVELOPER_DIR:-/Applications/Xcode.app/Contents/Developer} APPLE_KEYCHAIN_PROFILE=LANNA_NOTARY electron-builder --mac --arm64"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "1.4.0",
		"@earendil-works/pi-ai": "1.4.0",
		"@mozilla/readability": "^0.6.0",
		"@streamdown/cjk": "^1.0.3",
		"@streamdown/code": "^1.1.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"country-flag-icons": "^1.6.20",
		"electron-updater": "^6.8.9",
		"jose": "^6.2.12",
		"linkedom": "^0.18.13",
		"lucide-react": "^1.33.0",
		"motion": "^13.1.1",
		"msedge-tts": "2.1.1",
		"next": "^16.4.4",
		"pdfjs-dist": "^6.3.289",
		"pele": "^1.13.0",
		"radix-ui": "^1.6.7",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"remark-breaks": "^4.0.0",
		"streamdown": "^2.7.1",
		"tailwind-merge": "^3.6.0",
		"turndown": "^7.2.4",
		"typebox": "^1.3.27",
		"unbzip2-stream": "1.4.3",
		"use-stick-to-bottom": "^1.1.6"
	},
	"devDependencies": {
		"@next/eslint-plugin-next": "^16.4.4",
		"@resvg/resvg-js": "^2.6.2",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^24.0.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@types/turndown": "^5.0.6",
		"@types/unbzip2-stream": "1.4.3",
		"@typescript-eslint/parser": "^8.68.0",
		"electron": "^44.9.3",
		"electron-builder": "26.16.1",
		"eslint": "^9.39.5",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import": "^2.32.0",
		"oxfmt": "^0.79.0",
		"oxlint": "^1.94.0",
		"oxlint-tsgolint": "^7.0.2007",
		"puppeteer-core": "^25.8.0",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.19.0",
		"typescript": "^5.6.0"
	},
	"desktopName": "lanna.desktop"
}
